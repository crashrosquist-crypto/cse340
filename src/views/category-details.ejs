<%- include('partials/header') %>

<main>
    <h1><%= category.category_name %> Projects</h1>


    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.service_project_id %>">
                    <%= project.service_project_title %>
                </a>
            </li>
        <% }) %>
    </ul>
    <a href="/edit-category/<%= category.category_id %>" class="btn">Edit Category</a>
</main>

<%- include('partials/footer') %>
